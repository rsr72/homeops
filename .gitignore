# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Local PostgreSQL development environment
backend/.env.postgres

# Frontend generated files
frontend/node_modules/
frontend/dist/

# Frontend TypeScript build artifacts
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Playwright generated artifacts
frontend/playwright-report/
frontend/test-results/

# Terraform generated and sensitive local files
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/crash.log
infra/terraform/crash.*.log
infra/terraform/override.tf
infra/terraform/override.tf.json
infra/terraform/*_override.tf
infra/terraform/*_override.tf.json
infra/terraform/*.tfvars
infra/terraform/environments/*.tfvars
!infra/terraform/*.tfvars.example
!infra/terraform/environments/*.tfvars.example
*.tfplan
